# Start with system path
# Retrieve it from getconf, otherwise it's just current $PATH

is-executable getconf && PATH=$($(command -v getconf) PATH)

export HOMEBREW_PREFIX=$($DOTFILES_DIR/bin/is-supported $DOTFILES_DIR/bin/is-arm64 /opt/homebrew /usr/local)

prepend-path() {
  [ -d $1 ] && PATH="$1:$PATH"
}

append-path() {
  [ -d $1 ] && PATH="$PATH:$1"
}

# Prepend new items to path (if directory exists)
prepend-path "/bin"
prepend-path "/sbin"
prepend-path "/usr/bin"
prepend-path "/usr/sbin"
prepend-path "/usr/local/bin"
append-path "$HOME/bin"
append-path "$HOMEBREW_PREFIX/bin"
append-path "$HOMEBREW_PREFIX/sbin"
append-path "$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin"
append-path "$HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin"
append-path "$HOMEBREW_PREFIX/opt/grep/libexec/gnubin"
append-path "$HOMEBREW_PREFIX/opt/python/libexec/bin"
append-path "$DOTFILES_DIR/bin"

# Remove duplicates (preserving prepended items)
# Source: http://unix.stackexchange.com/a/40755

PATH=$(echo -n $PATH | awk -v RS=: '{ if (!arr[$0]++) {printf("%s%s",!ln++?"":":",$0)}}')
# Wrap up

export PATH
